<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gruppo2.musicplaylistmanager.controller.MainController"
            stylesheets="@style.css">

    <!-- ===== CONTENUTO PRINCIPALE ===== -->
    <center>
        <HBox>

            <!-- == PANNELLO SINISTRO: Libreria == -->
            <VBox prefWidth="500" styleClass="panel-left" spacing="12">
                <padding>
                    <Insets top="20" right="16" bottom="16" left="20"/>
                </padding>

                <Label text="Library" styleClass="panel-title"/>
                <Label text="Le tue tracce musicali" styleClass="panel-subtitle"/>

                <!-- Pulsante aggiungi traccia -->
                <HBox alignment="CENTER_LEFT">
                    <Button text="+ Aggiungi traccia"
                            onAction="#onAddTrackButton"
                            styleClass="btn, btn-primary"/>
                </HBox>

                <!-- Pulsanti Modifica / Elimina / Aggiungi a playlist -->
                <HBox spacing="8">
                    <Button text="Modifica"
                            onAction="#onEditTrackButton"
                            styleClass="btn"/>
                    <Button text="Elimina"
                            onAction="#onDeleteTrackButton"
                            styleClass="btn, btn-danger"/>
                    <Button text="Aggiungi a playlist"
                            onAction="#onAddToPlaylistButton"
                            styleClass="btn"/>
                </HBox>

                <!-- Tabella tracce -->
                <TableView fx:id="trackTableView" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="Nessuna traccia. Clicca + per iniziare."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="titleColumn"    text="Titolo"   prefWidth="165"/>
                        <TableColumn fx:id="authorColumn"   text="Autore"   prefWidth="100"/>
                        <TableColumn fx:id="genreColumn"    text="Genere"   prefWidth="85"/>
                        <TableColumn fx:id="yearColumn"     text="Anno"     prefWidth="50"/>
                        <TableColumn fx:id="durationColumn" text="Durata"   prefWidth="60"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- == PANNELLO DESTRO: Playlist == -->
            <VBox HBox.hgrow="ALWAYS" styleClass="panel-right" spacing="12">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Playlist" styleClass="panel-title"/>
                <Label text="Raccolte di tracce dalla libreria" styleClass="panel-subtitle"/>

                <!-- Pulsanti Crea / Elimina playlist -->
                <HBox spacing="8">
                    <Button text="+ Crea playlist"
                            onAction="#onCreatePlaylistButton"
                            styleClass="btn, btn-primary"/>
                    <Button text="Elimina playlist"
                            onAction="#onDeletePlaylistButton"
                            styleClass="btn, btn-danger"/>
                </HBox>

                <!-- Griglia di card playlist, scorribile -->
                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true">
                    <FlowPane fx:id="playlistFlowPane"
                              hgap="14" vgap="14"
                              styleClass="playlist-grid"/>
                </ScrollPane>

                <!-- Dettaglio playlist selezionata: tracce + pulsante rimozione.
                     Nascosto (visible=false, managed=false) finche' non si clicca
                     su una card; PlaylistController lo mostra dinamicamente. -->
                <VBox fx:id="playlistDetailPane"
                      visible="false" managed="false"
                      spacing="6"
                      styleClass="detail-pane">
                    <Label fx:id="playlistDetailLabel"
                           text="Tracce nella playlist"
                           styleClass="detail-title"/>
                    <ListView fx:id="playlistTrackListView" prefHeight="160"/>
                    <Button text="Rimuovi dalla playlist"
                            onAction="#onRemoveFromPlaylistButton"
                            styleClass="btn, btn-danger"/>
                </VBox>

            </VBox>

        </HBox>
    </center>

    <!-- ===== PLAYER IN BASSO (placeholder, verra' implementato in Sprint 2) ===== -->
    <bottom>
        <VBox styleClass="player-bar" spacing="6">
            <padding>
                <Insets top="10" right="24" bottom="10" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <!-- Info brano corrente -->
                <VBox prefWidth="220" spacing="2">
                    <Label text="Nessun brano in riproduzione" styleClass="player-now-title"/>
                    <Label text="—" styleClass="player-now-sub"/>
                </VBox>

                <!-- Pulsanti playback (centrati) -->
                <HBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="14">
                    <Button text="|◀" styleClass="player-icon"/>
                    <Button text="▶" styleClass="player-play"/>
                    <Button text="▶|" styleClass="player-icon"/>
                </HBox>

                <!-- Shuffle / Repeat (destra) -->
                <HBox prefWidth="220" alignment="CENTER_RIGHT" spacing="14">
                    <Button text="⇄" styleClass="player-icon"/>
                    <Button text="↺" styleClass="player-icon"/>
                </HBox>
            </HBox>

            <!-- Barra di avanzamento -->
            <HBox alignment="CENTER" spacing="10">
                <Label text="0:00" styleClass="player-time"/>
                <Slider HBox.hgrow="ALWAYS" min="0" max="100" value="0" styleClass="player-slider"/>
                <Label text="0:00" styleClass="player-time"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
